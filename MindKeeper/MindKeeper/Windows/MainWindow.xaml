<Window x:Class="MindKeeper.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="MindKeeper - Персональная система знаний"
        Height="700" Width="1100"
        WindowStartupLocation="CenterScreen"
        Closing="WindowClosing"
        Loaded="WindowLoaded"
        Background="{DynamicResource MaterialDesignPaper}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Верхняя панель (Header) -->
        <Border Background="{DynamicResource PrimaryHueMidBrush}" Padding="10,5">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Логотип и название -->
                <StackPanel Orientation="Horizontal" Grid.Column="0">
                    <materialDesign:PackIcon Kind="Brain" Width="30" Height="30" Foreground="White"/>
                    <TextBlock Text="MindKeeper" FontSize="20" FontWeight="Bold" Foreground="White" Margin="10,0,0,0"/>
                </StackPanel>

                <!-- Информация о пользователе и кнопки -->
                <StackPanel Orientation="Horizontal" Grid.Column="2">
                    <TextBlock x:Name="TxtUserInfo" 
                               Text="{Binding UserInfo}" 
                               Foreground="White" 
                               VerticalAlignment="Center" 
                               Margin="0,0,15,0"
                               FontWeight="SemiBold"/>
                    <Button x:Name="BtnSettings" 
                            Style="{StaticResource MaterialDesignToolButton}"
                            ToolTip="Настройки"
                            Click="BtnSettings_Click"
                            Margin="0,0,10,0">
                        <materialDesign:PackIcon Kind="Settings" Width="20" Height="20" Foreground="White"/>
                    </Button>
                    <Button x:Name="BtnLogout" 
                            Style="{StaticResource MaterialDesignToolButton}"
                            ToolTip="Выход"
                            Click="BtnLogout_Click">
                        <materialDesign:PackIcon Kind="Logout" Width="20" Height="20" Foreground="White"/>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Основная область: меню слева, Frame справа -->
        <Grid Grid.Row="1" Margin="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="260"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Навигационное меню -->
            <StackPanel Grid.Column="0" Margin="10">
                <Button x:Name="BtnNotes" Click="BtnNotes_Click" Style="{StaticResource MaterialDesignFlatButton}" Margin="0,5">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="ViewList" Width="22" Height="22" Margin="0,0,10,0"/>
                        <TextBlock Text="Мои заметки" FontSize="16"/>
                    </StackPanel>
                </Button>
                <Button x:Name="BtnSearch" Click="BtnSearch_Click" Style="{StaticResource MaterialDesignFlatButton}" Margin="0,5">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="Magnify" Width="22" Height="22" Margin="0,0,10,0"/>
                        <TextBlock Text="Поиск" FontSize="16"/>
                    </StackPanel>
                </Button>
                <Button x:Name="BtnTags" Click="BtnTags_Click" Style="{StaticResource MaterialDesignFlatButton}" Margin="0,5">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="Tag" Width="22" Height="22" Margin="0,0,10,0"/>
                        <TextBlock Text="Теги" FontSize="16"/>
                    </StackPanel>
                </Button>
                <Separator Margin="0,15,0,15"/>
                <Button x:Name="BtnAdmin" Click="BtnAdmin_Click" Style="{StaticResource MaterialDesignFlatButton}" Margin="0,5" Visibility="Collapsed">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="ShieldAccount" Width="22" Height="22" Margin="0,0,10,0"/>
                        <TextBlock Text="Администрирование" FontSize="16"/>
                    </StackPanel>
                </Button>
            </StackPanel>

            <!-- Frame для страниц -->
            <Frame x:Name="MainFrame" Grid.Column="1" NavigationUIVisibility="Hidden"/>
        </Grid>
    </Grid>
</Window>