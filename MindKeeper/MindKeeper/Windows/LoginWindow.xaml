<Window x:Class="MindKeeper.Windows.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:local="clr-namespace:MindKeeper.Windows"
        mc:Ignorable="d"
        Title="MindKeeper - Вход в систему" 
        Height="450" Width="500" 
        MinHeight="400" MinWidth="450"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResizeWithGrip"
        Background="{DynamicResource MaterialDesignPaper}"
        Closing="WindowClosing">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Заголовок с иконкой и названием -->
        <StackPanel Grid.Row="0" Margin="0,20,0,30" HorizontalAlignment="Center">
            <materialDesign:PackIcon Kind="Brain" 
                                     Width="70" Height="70" 
                                     Foreground="{DynamicResource PrimaryHueLightBrush}"
                                     Margin="0,0,0,10"/>
            <TextBlock Text="MindKeeper" 
                       FontSize="28" 
                       FontWeight="Bold"
                       Foreground="{DynamicResource PrimaryHueDarkBrush}"
                       HorizontalAlignment="Center"/>
            <TextBlock Text="Персональная система управления знаниями" 
                       FontSize="14" 
                       Foreground="{DynamicResource MaterialDesignBodyLight}"
                       HorizontalAlignment="Center"
                       Margin="0,5,0,0"/>
        </StackPanel>

        <TextBox x:Name="TbLogin" Grid.Row="1"
         materialDesign:HintAssist.Hint="Логин"
         Margin="0,10,0,0"
         FontSize="16"
         Padding="5"
         Width="350"
         HorizontalAlignment="Center">
            <TextBox.Style>
                <Style TargetType="TextBox" BasedOn="{StaticResource MaterialDesignFloatingHintTextBox}">
                    <Setter Property="materialDesign:TextFieldAssist.UnderlineBrush" Value="{DynamicResource PrimaryHueMidBrush}"/>
                </Style>
            </TextBox.Style>
        </TextBox>
        <!-- Поле Пароль -->
        <PasswordBox x:Name="TbPass" Grid.Row="2"
                     materialDesign:HintAssist.Hint="Пароль"
                     Style="{StaticResource MaterialDesignFloatingHintPasswordBox}"
                     Margin="0,20,0,0"
                     FontSize="16"
                     Padding="5"
                     Width="350"
                     HorizontalAlignment="Center"/>

        <!-- Кнопки -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" 
                    HorizontalAlignment="Center" Margin="0,30,0,0">
            <Button x:Name="BtnOk" 
                    Content="ВОЙТИ" 
                    Click="BtnOkClick" 
                    IsDefault="True"
                    Style="{StaticResource MaterialDesignRaisedButton}"
                    Width="130" Height="40"
                    Margin="0,0,15,0">
                <Button.Resources>
                    <Style TargetType="Button" BasedOn="{StaticResource MaterialDesignRaisedButton}">
                        <Setter Property="Background" Value="{DynamicResource PrimaryHueMidBrush}"/>
                        <Setter Property="Foreground" Value="White"/>
                    </Style>
                </Button.Resources>
            </Button>
            <Button x:Name="BtnCancel" 
                    Content="ОТМЕНА" 
                    IsCancel="True"
                    Click="BtnCancelClick"
                    Style="{StaticResource MaterialDesignOutlinedButton}"
                    Width="130" Height="40"/>
        </StackPanel>

        <!-- Сообщение об ошибке -->
        <TextBlock x:Name="TxtError" Grid.Row="4"
                   Text=""
                   Foreground="{DynamicResource MaterialDesignValidationErrorBrush}"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Bottom"
                   Margin="0,20"
                   FontSize="13"
                   FontWeight="SemiBold"/>

    </Grid>
</Window>