<?xml version="1.0" encoding="utf-8"?>
<Mapping Space="C-S" xmlns="http://schemas.microsoft.com/ado/2009/11/mapping/cs">
  <EntityContainerMapping StorageEntityContainer="Хранилище PersonalKnowledgeDBModelContainer" CdmEntityContainer="DataEntities">
    <EntitySetMapping Name="Entities">
      <EntityTypeMapping TypeName="PersonalKnowledgeDBModel.Entity">
        <MappingFragment StoreEntitySet="Entities">
          <ScalarProperty Name="EntityID" ColumnName="EntityID" />
