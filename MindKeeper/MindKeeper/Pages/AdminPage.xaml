<Page x:Class="MindKeeper.Pages.AdminPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
      Title="Управление пользователями">

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Text="👥 Управление пользователями" FontSize="22" FontWeight="Bold" Margin="0,0,0,15"/>

        <DataGrid Grid.Row="1" 
                  ItemsSource="{Binding Users}"
                  SelectedItem="{Binding SelectedUser}"
                  AutoGenerateColumns="False"
                  CanUserAddRows="False"
                  IsReadOnly="False"
                  Margin="0,5">
            <DataGrid.Columns>
                <DataGridTextColumn Header="ID" Binding="{Binding UserID}" Width="50"/>
                <DataGridTextColumn Header="Логин" Binding="{Binding Username}" Width="120"/>
                <DataGridTextColumn Header="ФИО" Binding="{Binding FullName}" Width="150"/>
                <DataGridTextColumn Header="Роль" Binding="{Binding Role}" Width="80"/>
                <DataGridCheckBoxColumn Header="Заблокирован" Binding="{Binding IsLocked}" Width="100"/>
                <DataGridTextColumn Header="Дата регистрации" Binding="{Binding CreatedAt, StringFormat='dd.MM.yyyy'}" Width="100"/>

                <!-- Колонка действий -->
                <DataGridTemplateColumn Header="Действия" Width="120">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <!-- Разблокировать (показывается только если IsLocked == true) -->
                                <Button Command="{Binding DataContext.UnlockUserCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                        CommandParameter="{Binding}"
                        Style="{StaticResource MaterialDesignToolButton}"
                        Margin="2"
                        ToolTip="Разблокировать пользователя"
                        Visibility="{Binding IsLocked, Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <materialDesign:PackIcon Kind="LockOpen" Width="18" Height="18"/>
                                </Button>

                                <!-- Заблокировать (показывается только если IsLocked == false) -->
                                <Button Command="{Binding DataContext.LockUserCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                        CommandParameter="{Binding}"
                        Style="{StaticResource MaterialDesignToolButton}"
                        Margin="2"
                        ToolTip="Заблокировать пользователя"
                        Visibility="{Binding IsLocked, Converter={StaticResource InverseBooleanToVisibilityConverter}}">
                                    <materialDesign:PackIcon Kind="Lock" Width="18" Height="18"/>
                                </Button>

                                <!-- Сбросить пароль -->
                                <Button Command="{Binding DataContext.ResetPasswordCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                        CommandParameter="{Binding}"
                        Style="{StaticResource MaterialDesignToolButton}"
                        Margin="2"
                        ToolTip="Сбросить пароль (default123)">
                                    <materialDesign:PackIcon Kind="Refresh" Width="18" Height="18"/>
                                </Button>

                                <!-- Удалить пользователя -->
                                <Button Command="{Binding DataContext.DeleteUserCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                        CommandParameter="{Binding}"
                        Style="{StaticResource MaterialDesignToolButton}"
                        Margin="2"
                        ToolTip="Удалить пользователя">
                                    <materialDesign:PackIcon Kind="Delete" Width="18" Height="18"/>
                                </Button>

                                <Button Command="{Binding DataContext.ChangeRoleCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                CommandParameter="{Binding}"
                                Style="{StaticResource MaterialDesignToolButton}"
                                Margin="2"
                                ToolTip="Сменить роль на противоположную">      
                                    <materialDesign:PackIcon Kind="AccountSwitch" Width="18" Height="18"/>
                                </Button>
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</Page>