<Page x:Class="MindKeeper.Pages.NotesPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
      Title="Мои заметки">
    <Grid Margin="10">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1.5*"/>
            <ColumnDefinition Width="2.5*"/>
        </Grid.ColumnDefinitions>

        <!-- ЛЕВАЯ ПАНЕЛЬ: дерево/поиск + кнопка новой заметки -->
        <Border Grid.Column="0" BorderBrush="{DynamicResource MaterialDesignDivider}" BorderThickness="0,0,1,0" Margin="0,0,10,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <StackPanel Margin="0,0,0,10">
                    <Button Content="➕ Новая заметка" Command="{Binding NewNoteCommand}"
                            Style="{StaticResource MaterialDesignRaisedButton}" Margin="0,5"/>

                    <!-- Расширенный поиск (сворачиваемый) -->
                    <Expander Header="🔍 Расширенный поиск" IsExpanded="{Binding IsSearchExpanded}" Margin="0,5">
                        <StackPanel Margin="0,5,0,10">
                            <TextBox Text="{Binding SearchId, UpdateSourceTrigger=PropertyChanged}"  materialDesign:HintAssist.Hint="ID заметки (целое число)"  Margin="0,5"/>

                            <TextBox Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}"
                                     materialDesign:HintAssist.Hint="Поисковый запрос" Margin="0,5"/>
                            <ComboBox ItemsSource="{Binding AllTags}" DisplayMemberPath="TagName"
          SelectedItem="{Binding SelectedSearchTag}"
          materialDesign:HintAssist.Hint="Фильтр по тегу" Margin="0,5"/>
                            <StackPanel Orientation="Horizontal" Margin="0,5">
                                <DatePicker SelectedDate="{Binding SearchDateFrom}"                 materialDesign:HintAssist.Hint="Дата изменения от"
                Width="150" Margin="0,0,10,0"/>
                                <DatePicker SelectedDate="{Binding SearchDateTo}"                 materialDesign:HintAssist.Hint="Дата изменения до"                Width="150"/>
                            </StackPanel>
                            <CheckBox Content="Только в заголовках" IsChecked="{Binding SearchOnlyTitle}" Margin="0,5"/>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,5">
                                <Button Content="Поиск" Command="{Binding PerformSearchCommand}"
                                        Style="{StaticResource MaterialDesignRaisedButton}"
                                        Background="{DynamicResource PrimaryHueMidBrush}"
                                        Margin="0,0,10,0"/>
                                <Button Content="Сброс" Command="{Binding ClearSearchCommand}"
                                        Style="{StaticResource MaterialDesignOutlinedButton}"/>
                            </StackPanel>
                        </StackPanel>
                    </Expander>
                </StackPanel>

                <!-- Дерево заметок (режим по умолчанию) -->
                <TreeView Grid.Row="1" ItemsSource="{Binding RootNotes}" 
          SelectedItemChanged="TreeView_SelectedItemChanged"
          Visibility="{Binding IsNotSearchMode, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <TreeView.ItemContainerStyle>
                        <Style TargetType="TreeViewItem">
                            <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}"/>
                        </Style>
                    </TreeView.ItemContainerStyle>
                    <TreeView.ItemTemplate>
                        <HierarchicalDataTemplate ItemsSource="{Binding Children}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding Note.Title}" FontWeight="Bold" FontSize="14"/>
                                <TextBlock Text="{Binding Note.NoteID, StringFormat=' (ID:{0})'}" 
                                           FontSize="10" Foreground="{DynamicResource MaterialDesignBodyLight}" Margin="5,0,0,0"/>
                                <TextBlock Text="{Binding Note.UpdatedAt, StringFormat='  (dd.MM.yyyy)'}" 
                                           FontSize="10" Foreground="{DynamicResource MaterialDesignBodyLight}" Margin="5,0,0,0"/>
                            </StackPanel>
                        </HierarchicalDataTemplate>
                    </TreeView.ItemTemplate>
                </TreeView>

                <!-- Результаты поиска (список) -->
                <ListView Grid.Row="1" ItemsSource="{Binding SearchResults}"
          SelectedItem="{Binding SelectedSearchResult}"
          Visibility="{Binding IsSearchMode, Converter={StaticResource BooleanToVisibilityConverter}}"
          SelectionChanged="SearchResult_SelectionChanged">
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Border BorderBrush="{DynamicResource MaterialDesignDivider}" BorderThickness="0,0,0,1" Padding="5">
                                <StackPanel>
                                    <TextBlock Text="{Binding Title}" FontWeight="Bold" FontSize="14"/>
                                    <TextBlock Text="{Binding NoteID, StringFormat='ID: {0}'}" 
                                               FontSize="10" Foreground="{DynamicResource MaterialDesignBodyLight}"/>
                                    <TextBlock Text="{Binding UpdatedAt, StringFormat='dd.MM.yyyy HH:mm'}" FontSize="10"/>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Grid>
        </Border>

        <!-- ПРАВАЯ ПАНЕЛЬ (без изменений, оставляем как есть) -->
        <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="10,0,0,0">
                <TextBlock Text="{Binding SelectedNote.NoteID, StringFormat='ID заметки: {0}'}" 
           FontSize="11" Foreground="{DynamicResource MaterialDesignBodyLight}"
           Margin="0,0,0,5" IsEnabled="{Binding IsNoteSelected}"/>
                <TextBox Text="{Binding SelectedNote.Title, UpdateSourceTrigger=PropertyChanged}"
                         materialDesign:HintAssist.Hint="Заголовок заметки"
                         Style="{StaticResource MaterialDesignFloatingHintTextBox}"
                         FontSize="16" Margin="0,5,0,10"
                         IsEnabled="{Binding IsNoteSelected}"/>

                <TextBox Text="{Binding SelectedNote.Content, UpdateSourceTrigger=PropertyChanged}"
                         materialDesign:HintAssist.Hint="Содержимое заметки"
                         TextWrapping="Wrap" AcceptsReturn="True"
                         MinHeight="200" MaxHeight="400"
                         VerticalScrollBarVisibility="Auto"
                         IsEnabled="{Binding IsNoteSelected}"/>

                <!-- Вкладки (Теги, Связанные заметки, Файлы, Напоминание) -->
                <TabControl Margin="0,10,0,0" IsEnabled="{Binding IsNoteSelected}">
                    <!-- Вкладка Теги -->
                    <TabItem Header="🏷️ Теги">
                        <StackPanel Margin="0,10">
                            <ItemsControl ItemsSource="{Binding CurrentNoteTags}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border BorderBrush="{DynamicResource PrimaryHueMidBrush}" BorderThickness="1" CornerRadius="10" 
                                                Background="{DynamicResource MaterialDesignPaper}" Padding="8,4" Margin="3,2" HorizontalAlignment="Left">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <materialDesign:PackIcon Kind="Tag" Width="16" Height="16" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                                <TextBlock Text="{Binding TagName}" FontSize="12" VerticalAlignment="Center" Grid.Column="1" Margin="0,0,12,0"/>
                                                <Button Grid.Column="2"
                                                        Command="{Binding DataContext.RemoveTagCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                                        CommandParameter="{Binding}"
                                                        Style="{StaticResource MaterialDesignToolButton}"
                                                        Width="18" Height="18" ToolTip="Удалить тег">
                                                    <materialDesign:PackIcon Kind="Close" Width="12" Height="12"/>
                                                </Button>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                <ComboBox ItemsSource="{Binding AllTags}" DisplayMemberPath="TagName"
                                          SelectedItem="{Binding SelectedTagToAdd}"
                                          materialDesign:HintAssist.Hint="Выберите или создайте тег"
                                          IsEditable="True" Text="{Binding NewTagName, UpdateSourceTrigger=PropertyChanged}"
                                          Style="{StaticResource MaterialDesignFloatingHintComboBox}"
                                          Width="200" Margin="0,0,10,0"/>
                                <Button Content="➕ Добавить" Command="{Binding AddTagCommand}"
                                        Style="{StaticResource MaterialDesignRaisedButton}"
                                        Background="{DynamicResource PrimaryHueMidBrush}"/>
                            </StackPanel>
                        </StackPanel>
                    </TabItem>

                    <!-- Вкладка Связанные заметки -->
                    <TabItem Header="🔗 Связанные заметки">
                        <ItemsControl ItemsSource="{Binding RelatedNotes}" Margin="0,10">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="{DynamicResource PrimaryHueMidBrush}" BorderThickness="1" CornerRadius="10" 
                                            Background="{DynamicResource MaterialDesignPaper}" Padding="8,4" Margin="3,2" HorizontalAlignment="Left">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <materialDesign:PackIcon Kind="ArrowRight" Width="16" Height="16" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="{Binding Title}" FontSize="12" Cursor="Hand" 
                                                       MouseLeftButtonDown="RelatedNote_Click" ToolTip="Перейти к заметке"
                                                       Grid.Column="1" Margin="0,0,12,0"/>
                                            <Button Grid.Column="2"
                                                    Command="{Binding DataContext.RemoveLinkCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                                    CommandParameter="{Binding}"
                                                    Style="{StaticResource MaterialDesignToolButton}" Width="18" Height="18" ToolTip="Удалить связь">
                                                <materialDesign:PackIcon Kind="Close" Width="12" Height="12"/>
                                            </Button>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </TabItem>

                    <!-- Вкладка Файлы -->
                    <TabItem Header="📎 Файлы">
                        <StackPanel Margin="0,10">
                            <Button Content="➕ Прикрепить файл" Command="{Binding AttachFileCommand}"
                                    Style="{StaticResource MaterialDesignOutlinedButton}" Margin="0,0,0,10" HorizontalAlignment="Left"/>
                            <ItemsControl ItemsSource="{Binding CurrentNoteFiles}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border BorderBrush="{DynamicResource PrimaryHueMidBrush}" BorderThickness="1" CornerRadius="10" 
                                                Background="{DynamicResource MaterialDesignPaper}" Padding="8,4" Margin="3,2" HorizontalAlignment="Left">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <materialDesign:PackIcon Kind="{Binding FileIcon}" Width="16" Height="16" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                                <TextBlock Text="{Binding FileName}" FontSize="12" Cursor="Hand" 
                                                           MouseLeftButtonDown="FileItem_MouseLeftButtonDown" ToolTip="Открыть файл"
                                                           Grid.Column="1" Margin="0,0,12,0" TextTrimming="CharacterEllipsis" MaxWidth="180"/>
                                                <Button Grid.Column="2"
                                                        Command="{Binding DataContext.DeleteFileCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                                        CommandParameter="{Binding}"
                                                        Style="{StaticResource MaterialDesignToolButton}" Width="18" Height="18" ToolTip="Удалить файл">
                                                    <materialDesign:PackIcon Kind="Close" Width="12" Height="12"/>
                                                </Button>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </TabItem>

                    <!-- Вкладка Напоминание -->
                    <TabItem Header="⏰ Напоминание">
                        <StackPanel Margin="0,10">
                            <DatePicker SelectedDate="{Binding SelectedNote.ReminderDate}" 
                                        materialDesign:HintAssist.Hint="Дата" Width="180" Margin="20,0,0,10" HorizontalAlignment="Left"/>
                            <TextBox Text="{Binding SelectedNote.ReminderTime, UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Left" 
                                     materialDesign:HintAssist.Hint="Время (например, 14:30)" Width="120" Margin="20,0,0,10"/>
                            <TextBox Text="{Binding SelectedNote.ReminderNote, UpdateSourceTrigger=PropertyChanged}"
                                     materialDesign:HintAssist.Hint="Примечание к напоминанию" Margin="20,0,0,10"/>
                            <CheckBox Content="Выполнено" IsChecked="{Binding SelectedNote.IsReminderCompleted}" Margin="20,0,0,10"/>
                            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                <Button Content="🗑 Очистить напоминание" 
            Command="{Binding ClearReminderCommand}"
            Style="{StaticResource MaterialDesignOutlinedButton}"
            IsEnabled="{Binding IsNoteSelected}"
            ToolTip="Удалить дату и время напоминания"/>
                            </StackPanel>
                        </StackPanel>
                    </TabItem>
                </TabControl>

                <!-- Кнопки действий (компактные, только иконки) -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,10">
                    <!-- Сохранить -->
                    <Button Command="{Binding SaveNoteCommand}"
            Style="{StaticResource MaterialDesignToolButton}"
            Margin="0,0,5,0"
            IsEnabled="{Binding IsNoteSelected}"
            ToolTip="Сохранить заметку (Ctrl+S)">
                        <materialDesign:PackIcon Kind="ContentSave" Width="20" Height="20"/>
                    </Button>

                    <!-- Удалить -->
                    <Button Command="{Binding DeleteNoteCommand}"
            Style="{StaticResource MaterialDesignToolButton}"
            Margin="0,0,5,0"
            IsEnabled="{Binding IsNoteSelected}"
            ToolTip="Удалить заметку">
                        <materialDesign:PackIcon Kind="Delete" Width="20" Height="20" Foreground="Red"/>
                    </Button>

                    <!-- Новая подзаметка -->
                    <Button Command="{Binding NewChildNoteCommand}"
            Style="{StaticResource MaterialDesignToolButton}"
            Margin="0,0,5,0"
            IsEnabled="{Binding IsNoteSelected}"
            ToolTip="Создать вложенную заметку">
                        <materialDesign:PackIcon Kind="FileTree" Width="20" Height="20"/>
                    </Button>

                    <!-- Сделать конспект (локальный) -->
                    <Button Command="{Binding SummarizeCommand}"
            Style="{StaticResource MaterialDesignToolButton}"
            Margin="0,0,5,0"
            IsEnabled="{Binding IsNoteSelected}"
            ToolTip="Сделать конспект (первые 2 предложения)">
                        <materialDesign:PackIcon Kind="FileDocumentOutline" Width="20" Height="20"/>
                    </Button>

                    <!-- ИИ-конспект (Gemini) -->
                    <Button Command="{Binding GenerateAiSummaryCommand}"
            Style="{StaticResource MaterialDesignToolButton}"
            Margin="0,0,5,0"
            IsEnabled="{Binding IsNoteSelected}"
            ToolTip="ИИ-конспект (Gemini)">
                        <materialDesign:PackIcon Kind="Robot" Width="20" Height="20"/>
                    </Button>

                    <!-- Экспорт в PDF -->
                    <Button Command="{Binding ExportPdfCommand}"
            Style="{StaticResource MaterialDesignToolButton}"
            Margin="0,0,5,0"
            IsEnabled="{Binding IsNoteSelected}"
            ToolTip="Экспорт в PDF">
                        <materialDesign:PackIcon Kind="FilePdf" Width="20" Height="20" Foreground="#E53935"/>
                    </Button>

                    <!-- Экспорт в DOCX -->
                    <Button Command="{Binding ExportDocxCommand}"
            Style="{StaticResource MaterialDesignToolButton}"
            Margin="0,0,0,0"
            IsEnabled="{Binding IsNoteSelected}"
            ToolTip="Экспорт в Word (DOCX)">
                        <materialDesign:PackIcon Kind="FileWord" Width="20" Height="20" Foreground="#1E88E5"/>
                    </Button>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>