<Page x:Class="MindKeeper.Pages.NotesPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
      Title="Мои заметки">

    <Grid Margin="10">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1.5*"/>
            <ColumnDefinition Width="2.5*"/>
        </Grid.ColumnDefinitions>

        <!-- Левая панель: список заметок -->
        <Border Grid.Column="0" BorderBrush="{DynamicResource MaterialDesignDivider}" BorderThickness="0,0,1,0" Margin="0,0,10,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <StackPanel Margin="0,0,0,10">
                    <Button Content="➕ Новая заметка" 
                            Command="{Binding NewNoteCommand}"
                            Style="{StaticResource MaterialDesignRaisedButton}"
                            Margin="0,5"/>
                    <TextBox x:Name="SearchBox" 
                             materialDesign:HintAssist.Hint="Поиск по заметкам..."
                             Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                             Margin="0,10,0,5"/>
                </StackPanel>

                <ListView Grid.Row="1" 
          ItemsSource="{Binding Notes}"
          SelectedItem="{Binding SelectedNote, Mode=TwoWay}">
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Border BorderBrush="{DynamicResource MaterialDesignDivider}" BorderThickness="0,0,0,1" Padding="5">
                                <StackPanel>
                                    <TextBlock Text="{Binding Title}" FontWeight="Bold" FontSize="14"/>
                                    <TextBlock Text="{Binding UpdatedAt, StringFormat='dd.MM.yyyy HH:mm'}" 
                               FontSize="10" Foreground="{DynamicResource MaterialDesignBodyLight}"/>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Grid>
        </Border>

        <!-- Правая панель: редактор заметки -->
        <Grid Grid.Column="1" Margin="10,0,0,0">
            <StackPanel>
                <TextBox Text="{Binding SelectedNote.Title, UpdateSourceTrigger=PropertyChanged}"
                         materialDesign:HintAssist.Hint="Заголовок заметки"
                         Style="{StaticResource MaterialDesignFloatingHintTextBox}"
                         FontSize="16" Margin="0,5,0,10"
                         IsEnabled="{Binding IsNoteSelected}"/>

                <TextBox Text="{Binding SelectedNote.Content, UpdateSourceTrigger=PropertyChanged}"
                         materialDesign:HintAssist.Hint="Содержимое заметки"
                         TextWrapping="Wrap" AcceptsReturn="True"
                         MinHeight="200" VerticalScrollBarVisibility="Auto"
                         IsEnabled="{Binding IsNoteSelected}"/>

                <StackPanel Orientation="Horizontal" Margin="0,10,0,0" HorizontalAlignment="Right">
                    <Button Content="💾 Сохранить" 
                            Command="{Binding SaveNoteCommand}"
                            Style="{StaticResource MaterialDesignRaisedButton}"
                            Margin="0,0,10,0"
                            IsEnabled="{Binding IsNoteSelected}"/>
                    <Button Content="🗑 Удалить" 
                            Command="{Binding DeleteNoteCommand}"
                            Style="{StaticResource MaterialDesignOutlinedButton}"
                            IsEnabled="{Binding IsNoteSelected}"/>
                </StackPanel>
            </StackPanel>
        </Grid>
    </Grid>
</Page>