<Page x:Class="MindKeeper.Pages.RemindersPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
      Title="Напоминания">

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Text="⏰ Предстоящие напоминания" FontSize="22" FontWeight="Bold" Margin="0,0,0,15"/>

        <DataGrid Grid.Row="1" ItemsSource="{Binding Reminders}"
                  AutoGenerateColumns="False" IsReadOnly="True"
                  SelectionChanged="DataGrid_SelectionChanged">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Заметка" Binding="{Binding Title}" Width="*"/>
                <DataGridTextColumn Header="Дата и время" Binding="{Binding ReminderDate, StringFormat='dd.MM.yyyy HH:mm'}" Width="120"/>
                <DataGridTextColumn Header="Примечание" Binding="{Binding ReminderNote}" Width="150"/>
                <DataGridTemplateColumn Header="Статус" Width="80">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <CheckBox IsChecked="{Binding IsReminderCompleted}" 
                                      Command="{Binding DataContext.ToggleCompletedCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                      CommandParameter="{Binding}"
                                      ToolTip="Отметить выполненным"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</Page>