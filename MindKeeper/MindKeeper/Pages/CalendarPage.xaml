<Page x:Class="MindKeeper.Pages.CalendarPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
      Title="Календарь напоминаний">

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,15">
            <Button Content="◀ Пред." Command="{Binding PreviousWeekCommand}" Style="{StaticResource MaterialDesignOutlinedButton}"/>
            <TextBlock Text="{Binding WeekRange}" FontSize="18" FontWeight="Bold" Margin="20,0"/>
            <Button Content="След. ▶" Command="{Binding NextWeekCommand}" Style="{StaticResource MaterialDesignOutlinedButton}"/>
        </StackPanel>

        <ItemsControl Grid.Row="1" ItemsSource="{Binding WeekDays}">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <WrapPanel/>
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border BorderBrush="{DynamicResource PrimaryHueMidBrush}" BorderThickness="1" 
                            CornerRadius="10" Background="{DynamicResource MaterialDesignPaper}"
                            Width="200" Height="250" Margin="5">
                        <StackPanel>
                            <TextBlock Text="{Binding DayName}" FontWeight="Bold" FontSize="14" 
                                       HorizontalAlignment="Center" Margin="0,5"/>
                            <TextBlock Text="{Binding Date, StringFormat='dd.MM.yyyy'}" 
                                       HorizontalAlignment="Center" FontSize="11" Foreground="{DynamicResource MaterialDesignBodyLight}"/>
                            <Separator Margin="5"/>
                            <ItemsControl ItemsSource="{Binding Reminders}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{DynamicResource MaterialDesignCardBackground}" 
        CornerRadius="8" Margin="0,0,0,8" Padding="8,6"
        Cursor="Hand" MouseLeftButtonDown="ReminderCard_Click">
                                            <StackPanel>
                                                <TextBlock Text="{Binding Title}" FontWeight="Bold" TextWrapping="Wrap" FontSize="13"/>
                                                <TextBlock Text="{Binding ReminderNote}" FontSize="10" Foreground="{DynamicResource MaterialDesignBodyLight}" TextWrapping="Wrap" Margin="0,4,0,0"/>
                                                <CheckBox Content="Выполнено" IsChecked="{Binding IsReminderCompleted}"
                  Command="{Binding DataContext.ToggleCompletedCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                  CommandParameter="{Binding}"
                  Margin="0,5,0,0"/>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </Grid>
</Page>