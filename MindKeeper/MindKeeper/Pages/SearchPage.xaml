<Page x:Class="MindKeeper.Pages.SearchPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
      Title="Поиск заметок">

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBox x:Name="TxtSearch" 
                 materialDesign:HintAssist.Hint="🔍 Поисковый запрос..."
                 Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}"
                 FontSize="14" Margin="0,0,0,10"/>

        <Expander Grid.Row="1" Header="Фильтры" IsExpanded="True" Margin="0,0,0,10">
            <StackPanel Margin="0,10">
                <!-- ComboBox без статических элементов -->
                <ComboBox ItemsSource="{Binding AllTagsWithEmpty}"
                          DisplayMemberPath="DisplayName"
                          SelectedValuePath="TagId"
                          SelectedValue="{Binding SelectedTagId}"
                          materialDesign:HintAssist.Hint="Фильтр по тегу"
                          Margin="0,5"/>
                <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                    <CheckBox Content="Только заголовок" IsChecked="{Binding OnlyTitle}" Margin="0,0,15,0"/>
                </StackPanel>
            </StackPanel>
        </Expander>

        <DataGrid Grid.Row="2" ItemsSource="{Binding SearchResults}"
                  AutoGenerateColumns="False" IsReadOnly="True"
                  MouseDoubleClick="DataGrid_MouseDoubleClick"
                  Margin="0,10,0,0">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Заголовок" Binding="{Binding Title}" Width="*"/>
                <DataGridTextColumn Header="Дата изменения" Binding="{Binding UpdatedAt, StringFormat='dd.MM.yyyy HH:mm'}" Width="120"/>
                <DataGridTemplateColumn Header="Теги" Width="150">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <ItemsControl ItemsSource="{Binding Tags}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="LightGray" CornerRadius="8" Padding="4,1" Margin="2">
                                            <TextBlock Text="{Binding TagName}" FontSize="9"/>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>

        <TextBlock Grid.Row="2" Text="Ничего не найдено" 
                   HorizontalAlignment="Center" VerticalAlignment="Center"
                   Visibility="{Binding NoResultsVisibility}"
                   Foreground="{DynamicResource MaterialDesignBodyLight}"/>
    </Grid>
</Page>